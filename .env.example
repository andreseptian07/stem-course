# Owner bootstrap only while Site access remains owner-private. First signed-in user is bound permanently.
OWNER_SETUP_ENABLED=false
# Node/MariaDB foundation; not consumed by the current Sites runtime.
DB_HOST=153.92.15.31
DB_PORT=3306
DB_USER=u209357671_course_bts
DB_NAME=u209357671_course_bts
# Fill privately in .env.local or Hostinger environment variables.
DB_PASSWORD=
DB_POOL_LIMIT=3
# Required for remote connections. Use disabled only on a verified private/local connection.
DB_SSL_MODE=required
# Optional trusted CA certificate, encoded as base64 (provided by the database operator).
DB_SSL_CA_BASE64=
# Optional isolated Judge0 service; HTTPS, network disabled for submissions.
JUDGE0_ENABLED=false
JUDGE0_URL=
JUDGE0_TOKEN=
# Optional RapidAPI provider credentials; API_HOST must equal URL hostname.
JUDGE0_API_KEY=
JUDGE0_API_HOST=
# Set language IDs according to the configured Judge0 installation.
JUDGE0_PYTHON_ID=71
JUDGE0_JAVASCRIPT_ID=63
JUDGE0_CPP_ID=54
