# Canonical public origin; no path. HTTPS required in production.
# Public browser address, even if hosting/proxy uses a different upstream hostname.
# Connect this domain and its HTTPS certificate before applying in production.
# Setup: docs/Domain-RuangSTEM.md. This example does not update the live environment.
APP_URL=https://ruangstem.com
# Enable after the operator has created the owner with auth:admin.
AUTH_REGISTRATION_ENABLED=false
# Only for next dev on localhost; production always requires HTTPS.
AUTH_ALLOW_LOCAL_HTTP=false
# Node/MariaDB production connection.
# Replace HOSTINGER_MYSQL_* with your private hPanel values.
DB_HOST=HOSTINGER_MYSQL_HOST
DB_PORT=3306
DB_USER=HOSTINGER_MYSQL_USER
DB_NAME=HOSTINGER_MYSQL_DATABASE
# Fill privately in .env.local or Hostinger environment variables.
DB_PASSWORD=
DB_POOL_LIMIT=3
# Required for remote connections. Use disabled only on a verified private/local connection.
DB_SSL_MODE=required
# Optional trusted CA certificate, encoded as base64 (provided by the database operator).
DB_SSL_CA_BASE64=
# Isolated Judge0 CE >=1.13.1; HTTPS with authentication, network disabled at
# service level (ENABLE_NETWORK=false, ALLOW_ENABLE_NETWORK=false).
# /about, /config_info, /languages and /workers must be accessible with these
# server-only credentials. Readiness is verified before official submission.
# Configuration and live acceptance: docs/UAT-Ruang-STEM/29-Tahap-5-Pemeriksa-Kode.md
JUDGE0_ENABLED=false
JUDGE0_URL=
JUDGE0_TOKEN=
# Optional RapidAPI provider credentials; API_HOST must equal URL hostname.
JUDGE0_API_KEY=
JUDGE0_API_HOST=
# Set language IDs according to the configured Judge0 installation.
JUDGE0_PYTHON_ID=71
JUDGE0_JAVASCRIPT_ID=63
JUDGE0_CPP_ID=54

# Default before the Super Admin saves origin-specific email settings.
# Use Kelola akses > Email akun to activate SMTP and require verification after UAT.
# Existing non-owner accounts must verify too; owner retains operator access.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# SMTP still needs manual activation from Super Admin after a successful test.
# disabled | smtp | preview (preview works only on localhost in development).
MAIL_DELIVERY=disabled
MAIL_FROM=
SMTP_HOST=
# 465 uses TLS; 587 requires STARTTLS. Certificate validation is mandatory.
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Private upload storage: default is ignored work/private-uploads in development.
# Production requires an absolute persistent directory OUTSIDE the application checkout and a stable ID.
# UPLOAD_STORAGE_DIR=/absolute/private/persistent/uploads
# UPLOAD_STORAGE_ID=ruang-stem-hosting
